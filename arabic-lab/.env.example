# Copy to .env.local and fill in. Never commit .env.local.

# Teacher who receives new-student and writing emails
TEACHER_EMAIL=Oula.Khalaf@alsamaproject.com
# Password for the /teacher dashboard
TEACHER_PASSWORD=change-me

# Supabase (Project settings → API). The service-role key stays on the server only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com → API keys) and a verified sender address
RESEND_API_KEY=
EMAIL_FROM="Alsama Arabic Lab <lab@alsamaproject.com>"
