# Copy this file to .env (same folder) and fill in. Never commit .env.
# Used only by `npm run generate-examples` on your computer.
ANTHROPIC_API_KEY=

# Optional: Lebanese computer voice for words without an Alsama recording
# (`npm run generate-audio`). From Azure → Speech service → Keys and Endpoint.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
